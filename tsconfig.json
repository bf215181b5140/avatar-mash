{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "outDir": "build/",
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    //    "allowImportingTsExtensions": true,
    /* for typeorm I think, check please */
    "strictPropertyInitialization": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    /* Do I need these? */
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true
    /* From nextjs */
    /* "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true */
  },
  "include": [
    "src/server/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "build/**/*",
    "src/website/**/*"
  ]
}
